# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# Neo4j. docker-compose.yml uses NEO4J_PASSWORD to initialise the container (min 8 chars).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-dev

# LLM. Only needed for scripts/ingest_pdf.py; the API and tests run without it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_CONCURRENCY=4

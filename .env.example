# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# Neo4j: topics, units, chunks, prerequisites, vector indexes.
# docker-compose.yml uses NEO4J_PASSWORD to initialise the container (min 8 chars).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-dev

# SQLite: users, study spaces, questions, attempts, mastery, flashcards.
# Relative paths are resolved against the project root. Created on first start.
SQLITE_PATH=data/app.db

# Uploaded files and per-source extraction results live under DATA_DIR.
DATA_DIR=data

# Background jobs (ingestion, flashcard generation). true: the API runs a worker thread itself.
# false: run `uv run python -m workers.run` in a separate terminal.
RUN_WORKER=true

# Limits per study space.
MAX_UPLOAD_MB=50
MAX_FETCH_MB=20
MAX_SOURCES_PER_SPACE=10
MAX_PAGES_PER_SPACE=300
OCR_LANG=eng                   # Tesseract language for scanned PDFs (needs `brew install tesseract`)

# Sign-in. Set SESSION_COOKIE_SECURE=true when the app is served over HTTPS.
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false

# LLM provider: ollama (local, free) | anthropic | openai (also any OpenAI-compatible server).
# LLM_MODEL defaults to llama3.1:8b for ollama and claude-sonnet-5-5 for anthropic; required for openai.
# Only the selected provider's settings are needed; Ollama isn't required with an API provider.
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192
LLM_CONCURRENCY=4

OLLAMA_BASE_URL=http://localhost:11434

ANTHROPIC_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=               # e.g. http://localhost:1234/v1 for LM Studio; leave empty for api.openai.com
